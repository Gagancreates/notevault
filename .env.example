# PostgreSQL connection string (Supabase: Project Settings → Database → Connection string → URI, "Session pooler")
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Secret used to sign session cookies (any long random string: openssl rand -hex 32)
AUTH_SECRET=change-me-to-a-long-random-string

# FastAPI embedding service
EMBEDDING_URL=http://localhost:8000
# Optional shared secret; must match EMBEDDING_API_KEY in the embedding service
EMBEDDING_API_KEY=

# Where uploaded files are stored
UPLOAD_DIR=./uploads
